BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# VirusTotal API — bepul kalit: https://virustotal.com (ro'yxatdan o'ting)
VIRUSTOTAL_API_KEY=

# AbuseIPDB API — bepul kalit: https://abuseipdb.com (ro'yxatdan o'ting)
ABUSEIPDB_API_KEY=

# URLhaus (abuse.ch) — API kalit kerak emas, avtomatik ishlaydi

# Telethon Userbot — ixtiyoriy, shubhali botlarni ichkaridan tekshirish uchun
# API ID va Hash: https://my.telegram.org/apps (bepul)
#
# 1-usul (eng qulay): userbot_session.session faylini shu papkaga tashlang
#   → TELETHON_API_ID va TELETHON_API_HASH ni to'ldiring, TELETHON_SESSION bo'sh qolsin
#
# 2-usul: String sessiya (.env orqali)
#   python3 -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c = TelegramClient(StringSession(), API_ID, 'API_HASH'); c.start(); print(c.session.save())"
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=
